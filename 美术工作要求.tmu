    │ │ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ │ \ \ │

    │ │ \ \ ┌─────┐ ┌─────┐ \ \ \ \ \ \ \ \ \ \ \ \ │ \ \ │

    │ │ \ \ │管路 │ │管路 │ \ \ \ \ \ \ \ \ \ \ \ \ │ \ \ │ ← 透明管路系统

    │ │ \ \ └─────┘ └─────┘ \ \ \ \ \ \ \ \ \ \ \ \ │ \ \ │ \ \ (仅READY+状态)

    │ │ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ │ \ \ │

    │ │ \ \ \ \ \ \ \ \ [显示屏] \ \ \ \ \ \ \ \ \ \ \ \ \ │ \ \ │ ← 状态显示屏

    │ │ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ │ \ \ │

    │ └───────────────────────────────┘ \ \ │

    │ \ \ \ \ \ \ \ ┌─────────────────┐ \ \ \ \ \ \ \ \ \ │ ← 底座

    │ \ \ \ \ \ \ \ │ \ \ ● \ ● \ ● \ ● \ \ │ \ \ \ \ \ \ \ \ \ │ \ \ 控制面板/指示灯

